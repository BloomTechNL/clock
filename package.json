{
  "name": "@bloom-group/clock",
  "version": "1.0.1",
  "description": "A testable clock built on the Temporal API: inject time instead of reading it, and control it in tests.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./file": {
      "types": "./lib/file.d.ts",
      "default": "./lib/file.js"
    }
  },
  "files": [
    "lib",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "husky",
    "prepublishOnly": "npm run deps:audit && npm run typecheck && npm test && npm run build",
    "lint": "eslint src test --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "deps:audit": "pnpm audit --audit-level low",
    "deps:install": "pnpm install --frozen-lockfile --lockfile-only --ignore-scripts && npm run deps:audit && pnpm install --frozen-lockfile --ignore-scripts && npm run prepare"
  },
  "keywords": [
    "clock",
    "time",
    "temporal",
    "testing",
    "dependency-injection"
  ],
  "author": "Bloom Group",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BloomTechNL/clock.git"
  },
  "homepage": "https://github.com/BloomTechNL/clock#readme",
  "bugs": {
    "url": "https://github.com/BloomTechNL/clock/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "temporal-polyfill": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "temporal-polyfill": "^1.0.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.8.1"
}
